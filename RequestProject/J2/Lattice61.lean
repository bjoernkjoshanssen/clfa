module

public import RequestProject.J2.Interval
public import RequestProject.J2.Congruence

/-!
# The lattice `#61` is the congruence lattice of a finite algebra

Main results (the second part of Theorem 3 of the note, the representation in `J₂`):

* `J2Cert.interval_D20_J2`: in the subgroup lattice of `Equiv.Perm (Fin 100)`, the interval
  `[D20, J2]` is order-isomorphic to the lattice `#61`. Here `J2` is the group generated by the
  ATLAS standard generators of the Hall–Janko group on 100 points and `D20` is the subgroup
  generated by two explicit permutations (a dihedral group of order 20).
* `J2Cert.con_J2_mod_D20`: the congruence lattice of the coset algebra `J2 ⧸ D20` (the finite
  set of left cosets, with the unary operations `x ↦ g • x` for `g ∈ J2`) is isomorphic to
  `#61`.
* `J2Cert.lattice61_representable`: `#61` is isomorphic to the congruence lattice of a finite
  (unary) algebra.

We do not need, and do not prove, that the group `J2` is the Hall–Janko group (for instance
that it has order `604800`), nor that `D20` is dihedral: the certificate only uses the explicit
permutations.
-/

@[expose] public section

namespace J2Cert

open P100

/-- The ATLAS standard generator `a` of the Hall–Janko group, acting on `Fin 100`. -/
def J2a : Equiv.Perm (Fin 100) := toPermEquiv pA

/-- The ATLAS standard generator `b` of the Hall–Janko group, acting on `Fin 100`. -/
def J2b : Equiv.Perm (Fin 100) := toPermEquiv pB

/-- The Hall–Janko group `J₂` in its permutation representation on 100 points. -/
def J2 : Subgroup (Equiv.Perm (Fin 100)) := Subgroup.closure {J2a, J2b}

/-- First generator of the subgroup `D₂₀` (a permutation of order 10). -/
def D20gen1 : Equiv.Perm (Fin 100) := toPermEquiv h1

/-- Second generator of the subgroup `D₂₀` (an involution). -/
def D20gen2 : Equiv.Perm (Fin 100) := toPermEquiv h2

/-- The dihedral subgroup `D₂₀ ≤ J₂`. -/
def D20 : Subgroup (Equiv.Perm (Fin 100)) := Subgroup.closure {D20gen1, D20gen2}

/-! The four permutations are exactly the tables listed in `J2Fast.Data`. -/

theorem J2a_apply (i : Fin 100) : (J2a i : ℕ) = genAData.getD i 0 := by
  have h : ∀ i : Fin 100, (pA.f.get i : ℕ) = genAData.getD i 0 := by native_decide
  exact h i
theorem J2b_apply (i : Fin 100) : (J2b i : ℕ) = genBData.getD i 0 := by
  have h : ∀ i : Fin 100, (pB.f.get i : ℕ) = genBData.getD i 0 := by native_decide
  exact h i
theorem D20gen1_apply (i : Fin 100) : (D20gen1 i : ℕ) = hgen1Data.getD i 0 := by
  have h : ∀ i : Fin 100, (h1.f.get i : ℕ) = hgen1Data.getD i 0 := by native_decide
  exact h i
theorem D20gen2_apply (i : Fin 100) : (D20gen2 i : ℕ) = hgen2Data.getD i 0 := by
  have h : ∀ i : Fin 100, (h2.f.get i : ℕ) = hgen2Data.getD i 0 := by native_decide
  exact h i

theorem H_eq_closure : H = Subgroup.closure {h1, h2} := by
  rw [H, T]
  congr 1
  ext x
  simp [allGens, gensOf]

theorem map_H : P100.toPermEquiv.mapSubgroup H = D20 := by
  rw [H_eq_closure, D20, MulEquiv.mapSubgroup_apply, MonoidHom.map_closure]
  congr 1
  rw [Set.image_pair]
  rfl

theorem map_G : P100.toPermEquiv.mapSubgroup G = J2 := by
  rw [G, J2, MulEquiv.mapSubgroup_apply, MonoidHom.map_closure]
  congr 1
  rw [Set.image_pair]
  rfl

theorem D20_le_J2 : D20 ≤ J2 := by
  rw [← map_H, ← map_G]
  exact (P100.toPermEquiv.mapSubgroup).monotone H_le_G

/-- **The interval `[D₂₀, J₂]` is the lattice `#61`.** -/
theorem interval_D20_J2 : Nonempty (Set.Icc D20 J2 ≃o L61) := by
  rw [← map_H, ← map_G]
  exact ⟨(OrderIso.Icc P100.toPermEquiv.mapSubgroup H G).symm.trans intervalIso⟩

/-- `D₂₀` as a subgroup of the group `J₂`. -/
abbrev D20inJ2 : Subgroup J2 := D20.subgroupOf J2

/-- **The congruence lattice of the finite coset algebra `J₂ ⧸ D₂₀` is the lattice `#61`.** -/
theorem con_J2_mod_D20 : Nonempty (UnaryCon (cosetOps D20inJ2) ≃o L61) := by
  obtain ⟨e⟩ := interval_D20_J2
  exact ⟨((conIso D20inJ2).trans (iccSubgroupOfIso D20 J2 D20_le_J2)).trans e⟩

instance : Finite (J2 ⧸ D20inJ2) := inferInstance

/-- **The lattice `#61` is representable**: it is isomorphic to the congruence lattice of a
finite algebra (here a unary algebra, namely the coset algebra `J₂ ⧸ D₂₀`). -/
theorem lattice61_representable :
    ∃ (X : Type) (_ : Finite X) (ι : Type) (F : ι → X → X), Nonempty (UnaryCon F ≃o L61) :=
  ⟨J2 ⧸ D20inJ2, inferInstance, J2, cosetOps D20inJ2, con_J2_mod_D20⟩

end J2Cert

end
